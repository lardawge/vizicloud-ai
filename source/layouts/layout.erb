<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= current_page.data.title || "Vizicloud — Defensive Architecture Advisory" %></title>
  <meta name="description" content="<%= current_page.data.description || "Vizicloud is a B2B advisory firm specializing in defensive automation architecture for organizations that can't afford to get it wrong." %>">
  <%= stylesheet_link_tag "site" %>
  <!-- Cloudflare Turnstile widget script, used by partials/_contact_form.erb -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="bg-slate-950 text-slate-300">

  <header class="border-b border-slate-800">
    <div class="mx-auto max-w-6xl px-6 py-6 flex items-center justify-between">
      <a href="/" class="font-mono text-sm tracking-widest uppercase text-slate-100">Vizicloud</a>
      <nav aria-label="Primary">
        <ul class="flex items-center gap-8 text-sm text-slate-300">
          <li><a href="#pain-points" class="hover:text-slate-100">Reality</a></li>
          <li><a href="#architecture" class="hover:text-slate-100">Approach</a></li>
          <li><a href="#founder" class="hover:text-slate-100">Founder</a></li>
          <li><a href="#engagement" class="hover:text-teal-300 text-teal-400">Engagement</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <%= yield %>

    <%# Contact partial is rendered sitewide, just before the closing </main> %>
    <%= partial "partials/contact_form" %>
  </main>

  <footer class="border-t border-slate-800">
    <div class="mx-auto max-w-6xl px-6 py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="font-mono text-xs uppercase tracking-widest text-slate-500">&copy; <%= Time.now.year %> Vizicloud. All rights reserved.</p>
      <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Defensive Architecture Advisory</p>
    </div>
  </footer>

</body>
</html>
