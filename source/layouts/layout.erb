<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= current_page.data.title || "ViziCloud — Systems & Automation for Recruiting Agencies" %></title>
  <meta name="description" content="<%= current_page.data.description || "ViziCloud is an AI/automation engineering practice for recruiting and staffing agencies — real software engineers, not another Zapier consultant." %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "site" %>
  <!-- Cloudflare Turnstile widget script, used by partials/_contact_form.erb -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <!-- 100% privacy-first analytics -->
  <script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
</head>
<body>

  <header id="top" class="sticky top-0 z-50 backdrop-blur-md bg-paper/90 border-b border-paper-line">
    <div class="wrap flex items-center justify-between py-[18px]">
      <a href="/" class="font-display font-bold text-xl flex items-center gap-2 no-underline">
        <span class="w-[9px] h-[9px] bg-copper rotate-45 inline-block"></span>ViziCloud
      </a>
      <a
        href="#cta"
        data-sa-event="cta_click_header"
        class="font-mono text-[13px] border border-navy px-4 py-2.5 text-navy no-underline transition-colors hover:bg-navy hover:text-paper"
      >Book Discovery Call</a>
    </div>
  </header>

  <main>
    <%= yield %>
  </main>

</body>
</html>
